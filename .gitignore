# Dependencies
node_modules/

# Build output
dist/

# Uploaded files (STORAGE_DRIVER=local, the local default directory)
/storage/

# Secrets — never commit real environment values. Use .env.example as the template.
.env
.env.*
!.env.example

# Test / coverage
coverage/

# Editor & OS
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Keys made by `bun run sftp:setup` (private keys — never commit)
/.sftp/
